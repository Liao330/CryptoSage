# === LLM Provider (必选: hy3 或 deepseek) ===
LLM_PROVIDER=hy3

# === Hy3 API (LLM_PROVIDER=hy3 时必填) ===
HY3_API_KEY=your-hy3-api-key-here
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1

# === DeepSeek API (LLM_PROVIDER=deepseek 时必填) ===
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_SLOW_MODEL=deepseek-v4-pro

# === Etherscan API (选填，链上数据需要) ===
# 免费档：3 calls/s, 10万次/日
# 申请地址：https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# === 期权与政府钱包观测（可选） ===
# Deribit 被企业网络拦截时，为期权请求单独指定 HTTP 或 SOCKS5 代理（例如 http://127.0.0.1:7890）
# DERIBIT_PROXY_URL=http://your-proxy:port
# DERIBIT_API_BASE_URL=https://www.deribit.com/api/v2/public
# 配置经过核验的政府钱包地址后，系统才会把“转入交易所”升级为链上确认：
# GOVERNMENT_ETH_ADDRESSES=0x...
# GOVERNMENT_BTC_ADDRESSES=bc1...
# BTC 目的地址也必须由运营方核验后配置，格式：交易所:地址|地址,交易所:地址
# EXCHANGE_BTC_ADDRESSES=Coinbase:bc1...|3...,Binance:bc1...

# === 仓位建议开关 (可选) ===
# 设为 false 可完全关闭仓位建议，只输出信号强度 + 关键价位 + 风险提示
ENABLE_POSITION_ADVICE=true

# === 模型配置 (可选) ===
# 快思考模型 (用于数据 Agent)
HY3_FAST_MODEL=hy3-fast
# 慢思考模型 (用于研判 Agent，支持 reasoning_effort=high)
HY3_SLOW_MODEL=hy3-slow

# === Agent 配置 (可选) ===
# Loop 1 最大步数（Orchestrator 最多循环次数；配合早退机制，正常 1-2 步即可结束）
MAX_ORCHESTRATOR_STEPS=3
# 进入融合的最低置信度
MIN_CONFIDENCE_THRESHOLD=0.7
# Loop 2 对抗最大轮数
MAX_CRITIC_ROUNDS=2
SHADOW_SETTLEMENT_INTERVAL_SECONDS=300
# 同时运行的分析任务上限（超限返回 HTTP 429）
MAX_CONCURRENT_ANALYSES=4

# === 回测配置 (可选) ===
# 固定持有周期；只有到期记录才允许结算
BACKTEST_HORIZON_HOURS=24
# 往返交易成本，单位 bps（10 bps = 0.1%）
BACKTEST_ROUND_TRIP_COST_BPS=10

# === 联网搜索 Provider (可选) ===
# hy3_web_search | tavily | serpapi | mock
MACRO_SEARCH_PROVIDER=hy3_web_search
# 币圈新闻默认以美国英文新闻区为主，避免中国本地财经新闻进入宏观方向证据
MACRO_NEWS_LANGUAGE=en-US
MACRO_NEWS_REGION=US
MACRO_NEWS_EDITION=US:en
MACRO_DDG_REGION=us-en
# TAVILY_API_KEY= (若使用 tavily)
# SERPAPI_API_KEY= (若使用 serpapi)

# === SSL 与网络 (可选) ===
# 企业网络环境若 OKX/Binance 被阻止或 SSL 检查设备截断，设为 false
# 警告：生产环境务必保持 true，关闭验证会使 API Key 面临中间人攻击风险
SSL_VERIFY=true
# HTTP/HTTPS 代理 (企业网络必需时设置)
# HTTPS_PROXY=http://your-proxy:port
# 本地启动脚本默认仅监听 127.0.0.1；确需局域网访问时显式设置
# BACKEND_HOST=0.0.0.0
# FRONTEND_HOST=0.0.0.0

# === 日志 (可选) ===
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件路径（留空则仅输出 stdout）
# LOG_FILE=./logs/cryptosage.log
